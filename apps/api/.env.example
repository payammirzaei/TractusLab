DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tractuslab
FRONTEND_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Comma-separated bootstrap admins for content workflow. Leave empty unless explicitly needed.
CONTENT_ADMIN_EMAILS=

# Never enable this in production. It only exists to make local/test flows usable before SMTP is configured.
EXPOSE_DEV_TOKENS=false

# disabled | smtp
EMAIL_DELIVERY_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tractuslab.local
SMTP_USE_TLS=true
